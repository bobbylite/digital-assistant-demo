# Copy to .env.local and fill in your own values (that file is gitignored).
# These only pre-fill the Connection panel on first load — none are secret,
# and none of them is the JWT (that's always typed into the UI at runtime,
# never read from env).

# AWS region your AgentCore harness runs in.
NEXT_PUBLIC_DEFAULT_REGION=us-east-2

# Harness endpoint qualifier (version/alias). "DEFAULT" unless you've
# published named endpoints.
NEXT_PUBLIC_DEFAULT_QUALIFIER=DEFAULT

# Your harness's own ARN (not the runtime ARN — see CLAUDE.md /
# .claude/skills/agentcore-harness for the harness-vs-runtime distinction).
# Leave blank to start with an empty field.
NEXT_PUBLIC_DEFAULT_HARNESS_ARN=

# ---------------------------------------------------------------------------
# OIDC sign-in (optional) — omit all of these and the app falls back to
# manual JWT paste only. Server-only: none of these carry NEXT_PUBLIC_,
# and none of them (client secret included) ever reach the browser.
# See CLAUDE.md for the full flow and why this exists.
# ---------------------------------------------------------------------------

# Your PingOne application's client ID and secret (confidential client —
# this app calls the token endpoint server-side, so a secret is required).
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Full discovery document URL, not just the issuer — e.g.
# https://auth.pingone.com/{environmentId}/as/.well-known/openid-configuration
# The app fetches this once and reads authorization_endpoint, token_endpoint,
# and jwks_uri from it; you never configure those individually.
OIDC_DISCOVERY_URL=

# Must exactly match a redirect URI registered on the PingOne application.
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Optional. Where PingOne sends the browser after signing out (RP-Initiated
# Logout) — must be registered as a "Sign Off URL" on the PingOne
# application, same idea as OIDC_REDIRECT_URI above but for logout. Defaults
# to the app's origin (derived from OIDC_REDIRECT_URI) if unset.
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/

# Space-separated. Must be enough for PingOne to issue a JWT (not opaque)
# access token carrying this app's client_id as audience — that's what lets
# AgentCore's authorizer accept it. Adjust to whatever your PingOne resource
# configuration requires.
OIDC_SCOPES=openid profile email

# Symmetric key used to encrypt the session cookie (AES-256-GCM).
# Generate your own: `openssl rand -base64 32`
SESSION_SECRET=
