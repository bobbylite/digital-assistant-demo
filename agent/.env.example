# Copy to .env and export before running `python main.py` (this is a plain
# Python process — nothing here is auto-loaded from a file; use `set -a;
# source .env; set +a` or your own dotenv tool of choice).

# Which Bedrock model this agent's Strands Agent calls.
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Port for the local dev server (BedrockAgentCoreApp.run()). AgentCore
# Runtime itself always expects 8080 in production; only override locally if
# 8080 is taken.
PORT=8080

# ---------------------------------------------------------------------------
# MCP tools (optional). JSON array of {"name", "url", "resourceId"}.
# "resourceId" is used both as the RFC 8693 token-exchange `resource`
# parameter and as half of the PDP authorization resource string
# ("resourceId:toolName") -- see authz.py / mcp_tools.py. Defaults to `name`
# if omitted. Leave unset to run with no tools.
# ---------------------------------------------------------------------------

# MCP_SERVERS_CONFIG=[{"name": "docs", "url": "http://localhost:9001/mcp", "resourceId": "docs-server"}]

# ---------------------------------------------------------------------------
# Fine-grained MCP tool authorization (optional). No real PingOne Authorize
# environment exists yet -- see authz.py for the documented, adjustable
# request/response contract this assumes. Leave AUTHZ_DECISION_URL unset to
# skip the check entirely (fail-open, logs a warning) -- useful for local
# dev without a PDP.
# ---------------------------------------------------------------------------

# AUTHZ_DECISION_URL=https://example.pingone.com/decision-endpoint
AUTHZ_TIMEOUT_MS=3000

# ---------------------------------------------------------------------------
# RFC 8693 token exchange for MCP calls (optional but required if
# MCP_SERVERS_CONFIG is set and you want per-resource downstream tokens
# rather than just forwarding the inbound token as-is). Same PingOne agent
# identity as the Next.js app's AGENT_CLIENT_ID/AGENT_CLIENT_SECRET -- see
# the root project's .env.local.example and CLAUDE.md's "Agent
# authentication" section. This is a separate process with its own env, so
# the values need to be duplicated here.
# ---------------------------------------------------------------------------

# OIDC_DISCOVERY_URL=https://auth.pingone.com/{environmentId}/as/.well-known/openid-configuration
# AGENT_CLIENT_ID=
# AGENT_CLIENT_SECRET=
AGENT_SCOPE=agent
AGENT_EXCHANGE_SCOPE=agent:exchange
